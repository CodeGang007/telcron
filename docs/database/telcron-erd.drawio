t=0;overflow=hidden;whiteSpace=wrap;html=1;align=center;fontColor=#555555;fontSize=9;" vertex="1" parent="8_r_product_fact_reports_created_at"><mxGeometry x="0" width="34" height="20" as="geometry"><mxRectangle width="34" height="20" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="8_r_product_fact_reports_created_at_c1" value="created_at" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontStyle=0;fontSize=11;" vertex="1" parent="8_r_product_fact_reports_created_at"><mxGeometry x="34" width="186" height="20" as="geometry"><mxRectangle width="186" height="20" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="8_r_product_fact_reports_created_at_c2" value="timestamptz" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=4;fontColor=#555555;fontSize=10;" vertex="1" parent="8_r_product_fact_reports_created_at"><mxGeometry x="220" width="214" height="20" as="geometry"><mxRectangle width="214" height="20" as="alternateBounds"/></mxGeometry></mxCell><UserObject label="risk_events  (→ Risk Events &amp; Notifications)" tooltip="A product-level risk signal, created once per (product, cause) — re-screens do not duplicate it.
Features: TC-P1-029, FR-13, PAS-04
Unique: UNIQUE (product_id, event_type, recall_id) WHERE recall_id IS NOT NULL; UNIQUE (certification_check_id) WHERE certification_check_id IS NOT NULL; UNIQUE (hazard_assessment_id) WHERE hazard_assessment_id IS NOT NULL; UNIQUE (price_snapshot_id) WHERE price_snapshot_id IS NOT NULL; UNIQUE (hazard_flag_id) WHERE hazard_flag_id IS NOT NULL
Checks: CASE event_type WHEN &#x27;recall_match&#x27; THEN recall_id IS NOT NULL AND screening_id IS NOT NULL WHEN &#x27;recall_near_match&#x27; THEN recall_id IS NOT NULL AND screening_id IS NOT NULL WHEN &#x27;hazard_threshold&#x27; THEN hazard_assessment_id IS NOT NULL WHEN &#x27;certification_change&#x27; THEN certification_check_id IS NOT NULL WHEN &#x27;price_drop&#x27; THEN price_snapshot_id IS NOT NULL WHEN &#x27;community_flag_confirmed&#x27; THEN hazard_flag_id IS NOT NULL END
Indexes: (product_id, detected_at DESC)
Composite FKs: (screening_id, product_id) → screenings(id, product_id); (hazard_assessment_id, product_id) → hazard_assessments(id, product_id)
Append-only." id="8_t_risk_events"><mxCell style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=2;align=center;resizeLast=1;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2376" y="426" width="434" height="50" as="geometry"/></mxCell></UserObject><mxCell id="8_r_risk_events_id" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=#fafafa;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;strokeColor=none;" vertex="1" parent="8_t_risk_events"><mxGeometry y="30" width="434" height="20" as="geometry"/></mxCell><mxCell id="8_r_risk_events_id_c0" value="PK" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=center;fontStyle=1;fontColor=#b85450;fontSize=9;" vertex="1" parent="8_r_risk_events_id"><mxGeometry x="0" width="34" height="20" as="geometry"><mxRectangle width="34" height="20" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="8_r_risk_events_id_c1" value="id" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontStyle=5;fontColor=#888888;fontSize=11;" vertex="1" parent="8_r_risk_events_id"><mxGeometry x="34" width="186" height="20" as="geometry"><mxRectangle width="186" height="20" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="8_r_risk_events_id_c2" value="uuid" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=4;fontColor=#555555;fontSize=10;" vertex="1" parent="8_r_risk_events_id"><mxGeometry x="220" width="214" height="20" as="geometry"><mxRectangle width="214" height="20" as="alternateBounds"/></mxGeometry></mxCell><UserObject label="hazard_dimensions  (→ Screening, Hazard &amp; Passport)" tooltip="Configurable scoring dimensions and weights. Codes are namespaced by context (safety.regulatory…).
Features: TC-P1-011
Unique: UNIQUE (code, context_code)
Checks: weight &gt; 0; code LIKE context_code || &#x27;.%&#x27;" id="8_t_hazard_dimensions"><mxCell style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=2;align=center;resizeLast=1;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2376" y="522" width="434" height="50" as="geometry"/></mxCell></UserObject><mxCell id="8_r_hazard_dimensions_code" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=#fafafa;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;strokeColor=none;" vertex="1" parent="8_t_hazard_dimensions"><mxGeometry y="30" width="434" height="20" as="geometry"/></mxCell><mxCell id="8_r_hazard_dimensions_code_c0" value="PK" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=center;fontStyle=1;fontColor=#b85450;fontSize=9;" vertex="1" parent="8_r_hazard_dimensions_code"><mxGeometry x="0" width="34" height="20" as="geometry"><mxRectangle width="34" height="20" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="8_r_hazard_dimensions_code_c1" value="code" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontStyle=5;fontColor=#888888;fontSize=11;" vertex="1" parent="8_r_hazard_dimensions_code"><mxGeometry x="34" width="186" height="20" as="geometry"><mxRectangle width="186" height="20" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="8_r_hazard_dimensions_code_c2" value="text" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=4;fontColor=#555555;fontSize=10;" vertex="1" parent="8_r_hazard_dimensions_code"><mxGeometry x="220" width="214" height="20" as="geometry"><mxRectangle width="214" height="20" as="alternateBounds"/></mxGeometry></mxCell><UserObject label="users  (→ Identity &amp; Access)" tooltip="One row per person. Holds account PII. Password optional (OAuth-only users). Deletion = anonymise.
Features: TC-P1-001/002/026, FR-14
Unique: UNIQUE (phone_e164) WHERE phone_verified_at IS NOT NULL
Checks: verification_level BETWEEN 0 AND 3; trust_score BETWEEN 0 AND 100; verification_level = 0 OR email_verified_at IS NOT NULL; phone_verified_at IS NULL OR phone_e164 IS NOT NULL; phone_e164 IS NULL OR phone_e164 ~ &#x27;^\+[1-9][0-9]{6,14}$&#x27;; (status = &#x27;deleted&#x27;) = (deleted_at IS NOT NULL)
