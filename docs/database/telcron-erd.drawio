lative="1" as="geometry"/></mxCell><mxCell id="5_e_70" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#7a7a7a;" edge="1" parent="1" source="5_r_hazard_dimension_scores_assessment_id" target="5_r_hazard_assessments_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5_e_71" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#7a7a7a;" edge="1" parent="1" source="5_r_hazard_dimension_scores_dimension_code" target="5_r_hazard_dimensions_code"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5_e_72" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#7a7a7a;" edge="1" parent="1" source="5_r_hazard_score_citations_assessment_id" target="5_r_hazard_assessments_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5_e_75" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;endArrow=ERzeroToOne;startArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#7a7a7a;" edge="1" parent="1" source="5_r_passports_screening_id" target="5_r_screenings_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5_e_76" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;endArrow=ERzeroToOne;startArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#7a7a7a;" edge="1" parent="1" source="5_r_passports_hazard_assessment_id" target="5_r_hazard_assessments_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5_e_77" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#7a7a7a;" edge="1" parent="1" source="5_r_passport_evidence_passport_id" target="5_r_passports_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5_e_78" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#7a7a7a;" edge="1" parent="1" source="5_r_passport_evidence_evidence_id" target="5_r_evidence_items_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5_legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br/&gt;★ thick border = &lt;b&gt;core&lt;/b&gt; table (first migration set)&lt;br/&gt;&lt;b&gt;PK&lt;/b&gt; primary key · &lt;b&gt;FK&lt;/b&gt; foreign key · &lt;b&gt;UK&lt;/b&gt; unique&lt;br/&gt;&lt;i&gt;italic name&lt;/i&gt; / &lt;b&gt;type?&lt;/b&gt; = nullable column&lt;br/&gt;&lt;b&gt;→ table&lt;/b&gt; = FK target (lines drawn only between neighbouring columns)&lt;br/&gt;dashed grey table = defined on another page&lt;br/&gt;Crow&#x27;s foot: ┼ one (mandatory) · o┼ zero-or-one · o&amp;lt; zero-or-many&lt;br/&gt;Hover a table header for purpose, constraints &amp;amp; indexes" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#999999;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="2960" y="110" width="390" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="6 · Wallet, Pricing &amp; Risk Alerts" id="pg_6___Wallet__Pricing___Risk_Alerts"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="4000" pageHeight="3000" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="6_title" value="&lt;b&gt;Telcron Database — Wallet, Pricing &amp; Risk Alerts&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#666666&#x27;&gt;14 tables · domains: Digital Wallet, Pricing, Risk Events &amp; Notifications · PostgreSQL 18&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="60" as="geometry"/></mxCell><UserObject label="products  (→ Product Catalogue (Registry))" tooltip="Canonical Product Identity Registry record. Never hard-deleted; duplicates are merged.
Features: FR-04/05, TC-P1-005/008, Arch v2 §4
Unique: UNIQUE (brand_id, model_number_normalized) WHERE model_number_normalized IS NOT NULL AND brand_id IS NOT NULL AND status &lt;&gt; &#x27;merged&#x27;
Checks: (status = &#x27;merged&#x27;) = (merged_into_product_id IS NOT NULL); merged_into_product_id IS NULL OR merged_into_product_id &lt;&gt; id; identity_confidence BETWEEN 0 AND 1; public_slug ~ &#x27;^[a-z0-9-]{6,80}$&#x27;; model_number_normalized IS NULL OR model_number_normalized ~ &#x27;^[A-Z0-9]+$&#x27;
Indexes: gist (canonical_name gist_trgm_ops(siglen=64)); (model_number_normalized); (category_id, status)
Composite FKs: (current_passport_id, id) → passports(id, product_id)
Rules: Merge target may not itself be merged (trigger). merge_products(src, dst) moves aliases, media, wallet items, reviews (function)." id="6_t_products"><mxCell style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=2;align=center;resizeLast=1;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="434" height="50" as="geometry"/></mxCell></UserObject><mxCell id="6_r_products_id" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=#fafafa;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;strokeColor=none;" vertex="1" parent="6_t_products"><mxGeometry y="30" width="434" height="20" as="geometry"/></mxCell><mxCell id="6_r_products_id_c0" value="PK" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=center;fontStyle=1;fontColor=#b85450;fontSize=9;" vertex="1" parent="6_r_products_id"><mxGeometry x="0" width="34" height="20" as="geometry"><mxRectangle width="34" height="20" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="6_r_products_id_c1" value="id" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontStyle=5;fontColor=#888888;fontSize=11;" vertex="1" parent="6_r_products_id"><mxGeometry x="34" width="186" height="20" as="geometry"><mxRectangle width="186" height="20" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="6_r_products_id_c2" value="uuid" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=4;fontColor=#555555;fontSize=10;" vertex="1" parent="6_r_products_id"><mxGeometry x="220" width="214" height="20" as="geometry"><mxRectangle width="214" height="20" as="alternateBounds"/></mxGeometry></mxCell><UserObject label="passports  (→ Screening, Hazard &amp; Passport)" tooltip="Versioned Product Passport. A new version on every verdict change. Composite FKs guarantee it cites THIS product&#x27;s screening/assessment.
Features: FR-10/11, PAS-01
Unique: UNIQUE (product_id, version); UNIQUE (id, product_id)
Checks: version &gt; 0; tier BETWEEN 0 AND 2; trust_score BETWEEN 0 AND 100; tier = 2 OR status_badge = &#x27;needs_information&#x27;; tier &lt; 2 OR (screening_id IS NOT NULL AND trust_score IS NOT NULL)
Indexes: (status_badge)
Composite FKs: (screening_id, product_id) → screenings(id, product_id); (hazard_assessment_id, product_id) → hazard_assessments(id, product_id)
Rules: Trigger: screening must be completed; verdict match ⇒ badge recalled; badge recalled ⇒ verdict match|near_match. Trigger: version = previous max + 1.
Append-only." id="6_t_passports"><mxCell style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=2;align=center;resizeLast=1;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="206" width="434" height="50" as="geometry"/></mxCell></UserObject><mxCell id="6_r_passports_id" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=#fafafa;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;strokeColor=none;" vertex="1" parent="6_t_passports"><mxGeometry y="30" width="434" height="20" as="geometry"/></mxCell><mxCell id="6_r_passports_id_c0" value="PK" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=center;fontStyle=1;fontColor=#b85450;fontSize=9;" vertex="1" parent="6_r_passports_id"><mxGeometry x="0" width="34" height="20" as="geometry"><mxRectangle width="34" height="20" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="6_r_passports_id_c1" value="id" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontStyle=5;fontColor=#888888;fontSize=11;" vertex="1" parent="6_r_passports_id"><mxGeometry x="34" width="186" height="20" as="geometry"><mxRectangle width="186" height="20" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="6_r_passports_id_c2" value="uuid" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=4;fontColor=#555555;fontSize=10;" vertex="1" parent="6_r_passports_id"><mxGeometry x="220" width="214" height="20" as="geometry"><mxRectangle width="214" height="20" as="alternateBounds"/></mxGeometry></mxCell><UserObject label="identification_requests  (→ Media &amp; AI Recognition)" tooltip="Each capture → identify attempt (Tier 0/1): input, model output, confidence, escalation, fallback answers.
Features: FR-01/02/03/05, TC-P1-003
Checks: num_nonnulls(media_asset_id, barcode_value, text_query) &gt;= 1; input_type NOT IN (&#x27;image&#x27;,&#x27;video&#x27;) OR media_asset_id IS NOT NULL; input_type &lt;&gt; &#x27;barcode&#x27; OR barcode_value IS NOT NULL; input_type &lt;&gt; &#x27;text&#x27; OR text_query IS NOT NULL; status &lt;&gt; &#x27;identified&#x27; OR resolved_product_id IS NOT NULL; confidence BETWEEN 0 AND 1
Indexes: (user_id, created_at DESC)" id="6_t_identification_requests"><mxCell style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=2;align=center;resizeLast=1;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="302" width="434" height="50" as="geometry"/></mxCell></UserObject><mxCell id="6_r_identification_requests_id" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=#fafafa;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;strokeColor=none;" vertex="1" parent="6_t_identification_requests"><mxGeometry y="30" width="434" height="20" as="geometry"/></mxCell><mxCell id="6_r_identification_requests_id_c0" value="PK" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=center;fontStyle=1;fontColor=#b85450;fontSize=9;" vertex="1" parent="6_r_identification_requests_id"><mxGeometry x="0" width="34" height="20" as="geometry"><mxRectangle width="34" height="20" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="6_r_identification_requests_id_c1" value="id" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontStyle=5;fontColor=#888888;fontSize=11;" vertex="1" parent="6_r_identification_requests_id"><mxGeometry x="34" width="186" height="20" as="geometry"><mxRectangle width="186" height="20" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="6_r_identification_requests_id_c2" value="uuid" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=4;fontColor=#555555;fontSize=10;" vertex="1" parent="6_r_identification_requests_id"><mxGeometry x="220" width="214" height="20" as="geometry"><mxRectangle width="214" height="20" as="alternateBounds"/></mxGeometry></mxCell><UserObject label="★ &lt;b&gt;wallet_items&lt;/b&gt;" tooltip="A product in a user&#x27;s Digital Wallet. Manual/barcode adds stay pending until a matching video verification exists.
Features: TC-P1-013/014, FR-12
Unique: UNIQUE (user_id, product_id) WHERE deleted_at IS NULL
Checks: add_method NOT IN (&#x27;manual&#x27;,&#x27;barcode&#x27;) OR status &lt;&gt; &#x27;active&#x27; OR verified_by_verification_id IS NOT NULL
Indexes: (user_id, created_at DESC) WHERE deleted_at IS NULL; (product_id) WHERE deleted_at IS NULL AND alerts_enabled
Composite FKs: (verified_by_verification_id, id) → wallet_item_verifications(id, wallet_item_id); (last_seen_passport_id, product_id) → passports(id, product_id)
