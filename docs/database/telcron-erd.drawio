0;strokeColor=#7a7a7a;" edge="1" parent="1" source="7_r_user_badges_badge_code" target="7_r_badges_code"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="7_legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br/&gt;★ thick border = &lt;b&gt;core&lt;/b&gt; table (first migration set)&lt;br/&gt;&lt;b&gt;PK&lt;/b&gt; primary key · &lt;b&gt;FK&lt;/b&gt; foreign key · &lt;b&gt;UK&lt;/b&gt; unique&lt;br/&gt;&lt;i&gt;italic name&lt;/i&gt; / &lt;b&gt;type?&lt;/b&gt; = nullable column&lt;br/&gt;&lt;b&gt;→ table&lt;/b&gt; = FK target (lines drawn only between neighbouring columns)&lt;br/&gt;dashed grey table = defined on another page&lt;br/&gt;Crow&#x27;s foot: ┼ one (mandatory) · o┼ zero-or-one · o&amp;lt; zero-or-many&lt;br/&gt;Hover a table header for purpose, constraints &amp;amp; indexes" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#999999;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="2376" y="110" width="390" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="8 · Community &amp; Reviews" id="pg_8___Community___Reviews"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="4000" pageHeight="3000" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="8_title" value="&lt;b&gt;Telcron Database — Community &amp; Reviews&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#666666&#x27;&gt;12 tables · domains: Community &amp; Reviews · PostgreSQL 18&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="60" as="geometry"/></mxCell><UserObject label="products  (→ Product Catalogue (Registry))" tooltip="Canonical Product Identity Registry record. Never hard-deleted; duplicates are merged.
Features: FR-04/05, TC-P1-005/008, Arch v2 §4
Unique: UNIQUE (brand_id, model_number_normalized) WHERE model_number_normalized IS NOT NULL AND brand_id IS NOT NULL AND status &lt;&gt; &#x27;merged&#x27;
Checks: (status = &#x27;merged&#x27;) = (merged_into_product_id IS NOT NULL); merged_into_product_id IS NULL OR merged_into_product_id &lt;&gt; id; identity_confidence BETWEEN 0 AND 1; public_slug ~ &#x27;^[a-z0-9-]{6,80}$&#x27;; model_number_normalized IS NULL OR model_number_normalized ~ &#x27;^[A-Z0-9]+$&#x27;
Indexes: gist (canonical_name gist_trgm_ops(siglen=64)); (model_number_normalized); (category_id, status)
Composite FKs: (current_passport_id, id) → passports(id, product_id)
Rules: Merge target may not itself be merged (trigger). merge_products(src, dst) moves aliases, media, wallet items, reviews (function)." id="8_t_products"><mxCell style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=2;align=center;resizeLast=1;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="434" height="50" as="geometry"/></mxCell></UserObject><mxCell id="8_r_products_id" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=#fafafa;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;strokeColor=none;" vertex="1" parent="8_t_products"><mxGeometry y="30" width="434" height="20" as="geometry"/></mxCell><mxCell id="8_r_products_id_c0" value="PK" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=center;fontStyle=1;fontColor=#b85450;fontSize=9;" vertex="1" parent="8_r_products_id"><mxGeometry x="0" width="34" height="20" as="geometry"><mxRectangle width="34" height="20" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="8_r_products_id_c1" value="id" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontStyle=5;fontColor=#888888;fontSize=11;" vertex="1" parent="8_r_products_id"><mxGeometry x="34" width="186" height="20" as="geometry"><mxRectangle width="186" height="20" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="8_r_products_id_c2" value="uuid" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=4;fontColor=#555555;fontSize=10;" vertex="1" parent="8_r_products_id"><mxGeometry x="220" width="214" height="20" as="geometry"><mxRectangle width="214" height="20" as="alternateBounds"/></mxGeometry></mxCell><UserObject label="media_assets  (→ Media &amp; AI Recognition)" tooltip="A use of a blob by an owner (user upload) or source (ingested): ownership and visibility live here, not on the file.
Features: TC-P1-003/006
Unique: UNIQUE (owner_user_id, blob_id) WHERE owner_user_id IS NOT NULL AND deleted_at IS NULL
Checks: num_nonnulls(owner_user_id, data_source_code) &gt;= 1
Indexes: (owner_user_id, created_at DESC)" id="8_t_media_assets"><mxCell style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=2;align=center;resizeLast=1;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="206" width="434" height="50" as="geometry"/></mxCell></UserObject><mxCell id="8_r_media_assets_id" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=#fafafa;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;strokeColor=none;" vertex="1" parent="8_t_media_assets"><mxGeometry y="30" width="434" height="20" as="geometry"/></mxCell><mxCell id="8_r_media_assets_id_c0" value="PK" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=center;fontStyle=1;fontColor=#b85450;fontSize=9;" vertex="1" parent="8_r_media_assets_id"><mxGeometry x="0" width="34" height="20" as="geometry"><mxRectangle width="34" height="20" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="8_r_media_assets_id_c1" value="id" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontStyle=5;fontColor=#888888;fontSize=11;" vertex="1" parent="8_r_media_assets_id"><mxGeometry x="34" width="186" height="20" as="geometry"><mxRectangle width="186" height="20" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="8_r_media_assets_id_c2" value="uuid" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=4;fontColor=#555555;fontSize=10;" vertex="1" parent="8_r_media_assets_id"><mxGeometry x="220" width="214" height="20" as="geometry"><mxRectangle width="214" height="20" as="alternateBounds"/></mxGeometry></mxCell><UserObject label="recalls  (→ Recalls)" tooltip="Official recall notices (CPSC, openFDA; later NHTSA, EU Safety Gate…). Reference data.
Features: FR-06, TC-P1-010
Unique: UNIQUE (data_source_code, external_id)
Indexes: gin (search_tsv); (recall_date DESC)" id="8_t_recalls"><mxCell style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=2;align=center;resizeLast=1;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="302" width="434" height="50" as="geometry"/></mxCell></UserObject><mxCell id="8_r_recalls_id" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=#fafafa;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;strokeColor=none;" vertex="1" parent="8_t_recalls"><mxGeometry y="30" width="434" height="20" as="geometry"/></mxCell><mxCell id="8_r_recalls_id_c0" value="PK" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=center;fontStyle=1;fontColor=#b85450;fontSize=9;" vertex="1" parent="8_r_recalls_id"><mxGeometry x="0" width="34" height="20" as="geometry"><mxRectangle width="34" height="20" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="8_r_recalls_id_c1" value="id" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontStyle=5;fontColor=#888888;fontSize=11;" vertex="1" parent="8_r_recalls_id"><mxGeometry x="34" width="186" height="20" as="geometry"><mxRectangle width="186" height="20" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="8_r_recalls_id_c2" value="uuid" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=4;fontColor=#555555;fontSize=10;" vertex="1" parent="8_r_recalls_id"><mxGeometry x="220" width="214" height="20" as="geometry"><mxRectangle width="214" height="20" as="alternateBounds"/></mxGeometry></mxCell><UserObject label="★ &lt;b&gt;reviews&lt;/b&gt;" tooltip="Product reviews by users, or ingested from marketplaces (keyed on source + external id so re-ingestion updates, not duplicates).
Features: TC-P1-022
Unique: UNIQUE (data_source_code, external_id) WHERE origin = &#x27;ingested&#x27;
