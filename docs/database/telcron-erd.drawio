rce="overview_d_rewards" target="overview_d_community"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="overview_oe_17" value="per user" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="overview_d_rewards" target="overview_d_identity"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="overview_note" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br/&gt;Arrows point from the referencing domain to the referenced one (curated — the detail pages show every FK).&lt;br/&gt;Every user-owned domain references &lt;b&gt;Identity &amp;amp; Access&lt;/b&gt; (users); every product-related domain references the &lt;b&gt;Product Catalogue&lt;/b&gt; (products).&lt;br/&gt;&lt;b&gt;Reference data&lt;/b&gt;: Sources, Recalls, Certifications · &lt;b&gt;User data&lt;/b&gt;: Wallet, Community, Rewards, Feed history · &lt;b&gt;Derived&lt;/b&gt;: Screening, Hazard, Passport, Risk events (reproducible from reference + user data).&lt;br/&gt;Pages 2–10 hold full column detail; hover a table header for constraints and indexes." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#999999;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="800" y="956" width="680" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 · Identity &amp; Access" id="pg_2___Identity___Access"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="4000" pageHeight="3000" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2_title" value="&lt;b&gt;Telcron Database — Identity &amp; Access&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#666666&#x27;&gt;7 tables · domains: Identity &amp; Access · PostgreSQL 18&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="60" as="geometry"/></mxCell><UserObject label="★ &lt;b&gt;users&lt;/b&gt;" tooltip="One row per person. Holds account PII. Password optional (OAuth-only users). Deletion = anonymise.
Features: TC-P1-001/002/026, FR-14
Unique: UNIQUE (phone_e164) WHERE phone_verified_at IS NOT NULL
Checks: verification_level BETWEEN 0 AND 3; trust_score BETWEEN 0 AND 100; verification_level = 0 OR email_verified_at IS NOT NULL; phone_verified_at IS NULL OR phone_e164 IS NOT NULL; phone_e164 IS NULL OR phone_e164 ~ &#x27;^\+[1-9][0-9]{6,14}$&#x27;; (status = &#x27;deleted&#x27;) = (deleted_at IS NOT NULL)
