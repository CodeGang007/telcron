# The web app on the Lightsail host: static files, automatic HTTPS, single-page fallback.
# WEB_HOST is replaced with the real hostname when this file is installed (see setup-web-host.sh).
WEB_HOST {
	root * /var/www/telcron
	encode gzip

	# Vite fingerprints everything under /assets, so it can be cached for good; index.html never.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@page not path /assets/*
	header @page Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	try_files {path} /index.html
	file_server
}
