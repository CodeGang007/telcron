# Copy to .env.local (git-ignored). Local development only — never real secrets.
ENV=local
DATABASE_URL=postgresql+asyncpg://telcron:telcron@localhost:5436/telcron
REDIS_URL=redis://localhost:6381
WEB_ORIGIN=http://localhost:3200
VITE_API_URL=http://localhost:4310
# 32+ random bytes: `openssl rand -hex 32`. The API refuses to start outside local with this default.
JWT_SECRET=change-me-change-me-change-me-change-me
# Local only: show verification codes on the sign-up screen instead of sending them.
DEV_EXPOSE_CODES=true
# stub | bedrock. `bedrock` is not wired yet (WO-004).
AI_PROVIDER=stub
# Local demos only: confirm coins after this many seconds instead of the rule's 10 minutes.
# COIN_CONFIRM_DELAY_SECONDS=15
# Set this to create admin@telcron.example.com when seeding (ENV=local only). Leave unset anywhere else.
# SEED_ADMIN_PASSWORD=
