# Copy to .env (git-ignored) and adjust if needed. Local development only — never real secrets.
POSTGRES_USER=telcron
POSTGRES_PASSWORD=telcron_dev
POSTGRES_DB=telcron
# 5432 is often taken by a system Postgres, so Telcron defaults to 5433
DB_PORT=5433
DB_TEST_PORT=55433
ADMINER_PORT=8080

# Connection string for applications running on the host
DATABASE_URL=postgresql://telcron:telcron_dev@127.0.0.1:5433/telcron

# ── Application (backend/ and frontend/) ─────────────────────────────────────────────────────────
ENV=local
REDIS_PORT=6381
REDIS_URL=redis://127.0.0.1:6381
WEB_ORIGIN=http://localhost:3200
VITE_API_URL=http://localhost:4310
# 32+ random bytes: `openssl rand -hex 32`. The API refuses to start outside local with this default.
JWT_SECRET=change-me-change-me-change-me-change-me
# Local only: show verification codes on the sign-up screen instead of sending them.
DEV_EXPOSE_CODES=true
# stub | llm. `llm` scores hazards with a model on an OpenAI-compatible API (Groq's free plan by
# default: create a key at console.groq.com) and falls back to the keyword stub if it cannot answer.
AI_PROVIDER=stub
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# Local demos only: the app seed shortens every earn rule's confirmation delay to this many seconds.
# COIN_CONFIRM_DELAY_SECONDS=15
# Set this to create an admin when seeding (ENV local or dev only). Never set it in production.
# SEED_ADMIN_PASSWORD=
# Product research (WO-014): a free Tavily key (tavily.com) for the web search; without one the
# model's built-in browser search is used, a few times a day.
# TAVILY_API_KEY=
# Research runs one member may start in a day (DEF-049).
# RESEARCH_PER_USER_PER_DAY=5
# Vectors (WO-015): run `make embedder` and point the API and Worker at it. Unset = no vectors;
# search and the assistant fall back to text matching.
# EMBED_URL=http://localhost:4320
# Last model in line when Groq's daily allowance is spent (aistudio.google.com). See
# docs/runbooks/api-keys.md for every key, where it lives and how to replace it.
# GEMINI_API_KEY=
